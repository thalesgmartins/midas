services:
  midas:
    build:
      context: .
      dockerfile: Dockerfile
    image: midas:local
    # Monta o código local para hot-reload sem precisar rebuildar a imagem a cada edição:
    volumes:
      - ./app:/app/app
      - ./alembic:/app/alembic
      - ./data:/app/data
    command: ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
    restart: "no"
