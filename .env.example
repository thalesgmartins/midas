# Diretorio de dados locais (no container: /app/data via volume ./data:/app/data)
DATA_DIR=./data

# URL do banco de dados (SQLite por padrao)
DATABASE_URL=sqlite:///./data/midas.db

# Fuso horario para logs e datas de atualizacao no container
TZ=America/Sao_Paulo

# Alertas opcionais no Telegram (Monitor CVM)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Resumo opcional de Fatos Relevantes via Gemini API (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
