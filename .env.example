# Diretorio de dados locais (no container: /app/data via volume ./data:/app/data)
DATA_DIR=./data

# URL do banco de dados (SQLite por padrao)
DATABASE_URL=sqlite:///./data/midas.db

# Fuso horario para logs e datas de atualizacao no container
TZ=America/Sao_Paulo

# Autenticacao exclusiva via Google OAuth 2.0 (preencha para bloquear acesso publico)
SECRET_KEY=troque-por-uma-chave-aleatoria-forte
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://midas.thalesgmartins.com.br/auth/google/callback
ALLOWED_EMAILS=thalesdiniz30@gmail.com

# Alertas opcionais no Telegram (Monitor CVM)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Resumo opcional de Fatos Relevantes via Gemini API (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
